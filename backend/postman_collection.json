{
  "info": {
    "name": "Mel Wallet - demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:3000" },
    { "key": "destino", "value": "ACC-1234" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login como Cliente Demo (guarda el token)",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"demo@mel.com\",\"password\":\"demo1234\"}" },
        "url": "{{base}}/api/auth/login"
      }
    },
    {
      "name": "2. Transferir a la cuenta de la app (cambia la variable 'destino')",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"to\":\"{{destino}}\",\"amount\":50}" },
        "url": "{{base}}/api/transfer"
      }
    }
  ]
}
