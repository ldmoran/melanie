{
  "info": {
    "name": "Mel Wallet - demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:3000" },
    { "key": "destino", "value": "ACC-1234" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Registrar otro usuario (guarda el token)",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["const r = pm.response.json(); pm.collectionVariables.set('token', r.token); console.log('Cuenta: ' + r.user.account);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"name\":\"Usuario Postman\",\"email\":\"postman{{$timestamp}}@mel.com\",\"password\":\"postman123\"}" },
        "url": "{{base}}/api/auth/register"
      }
    },
    {
      "name": "2. Depositar fondos a ese usuario",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"amount\":1000}" },
        "url": "{{base}}/api/deposit"
      }
    },
    {
      "name": "3. Transferir a la cuenta de la app (cambia la variable 'destino')",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"to\":\"{{destino}}\",\"amount\":50}" },
        "url": "{{base}}/api/transfer"
      }
    }
  ]
}
